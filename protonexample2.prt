Device = 16F15355
Declare Optimiser_Level = 0
Declare Bootloader = OFF

Declare EEPROM_Size = 64
Declare EEPROM_Address = $1F80
Dim HEF_Array [64] As Byte Heap
Dim i As Byte

Config1 FEXTOSC_OFF, RSTOSC_HFINT32, CLKOUTEN_OFF, CSWEN_OFF, FCMEN_OFF
Config2 MCLRE_OFF, PWRTE_OFF, LPBOREN_OFF, BOREN_ON, BORV_HI, ZCD_OFF, PPS1WAY_OFF, STVREN_ON
Config3 WDTCPS_WDTCPS_31, WDTE_OFF, WDTCWS_WDTCWS_7, WDTCCS_SC
Config4 BBSIZE_BB512, BBEN_OFF, SAFEN_ON, WRTAPP_OFF, WRTB_OFF, WRTC_OFF, WRTSAF_OFF, LVP_OFF
Config5 CP_OFF


     Xtal = 32


     ANSELA = %00000000
     TRISA = %00001110
     ODCONA = %00000000
     ANSELB = %00000000
     TRISB = %00001001
     ODCONB = %00000000

     WPUB.3 = 1

     ODCONC = %00000000
     ANSELC = %00000100
     TRISC = %10100101

     PORTE.3 = 1

     FVRCON = %10001111
     ADCON0 = %01001001
     ADCON1 = %00110011

    Symbol LED = LATB.2
    Symbol MOD = LATA.4
    Symbol ONOFF = LATC.1

    Symbol ATTEN_INF = LATA.1
    Symbol WPU_ATTEN_INF = WPUA.1

    Symbol ATTEN_12 = LATA.2
    Symbol WPU_ATTEN_12 = WPUA.2

    Symbol ATTEN_6 = LATA.3
    Symbol WPU_ATTEN_6 = WPUA.3


    Symbol AUX1_IN = PORTB.0
    Symbol AUX2_IN = PORTC.7
    Symbol AUX1_OUT = LATB.1
    Symbol AUX2_OUT = LATC.4

    Symbol PHY_Enable = LATA.5
    Symbol CH9121_CFG = LATA.7

    Dim OmnirigBuffer As Byte
    Dim HEF_Address As Word = $1F80
    Dim Serno As String *8
    Dim enc_CONTROL_byte As Byte
    Dim DATA_byte As Byte
    Dim DATA_byte_Old As Byte
    Dim Delay_Index As Byte
    Dim CONTROL_byte As Byte
    Dim enc_DATA_byte As Byte
    Dim LCU_BS_1 As Byte
    Dim LCU_BS_2 As Byte
    Dim KEY_byte As Byte
    Dim led_count As Byte
    Dim ATTEN_BYTE As Byte
    Dim Delay_actual As Byte
    Dim IO_config_byte As Byte
    Dim Chan_1_PTT_Set As IO_config_byte.2
    Dim CH1 As Byte
    Dim CH1_IO_Cfg As Byte
    Dim CH2 As Byte
    Dim CH2_IO_Cfg As Byte
    Dim PHY_Power As Byte
    Dim ADC_Byte As Byte
    Dim ADC_Full As Word
    Dim Loop_Count As Byte

    Dim OLD_WPU_ATTEN_INF  As Byte
    Dim OLD_WPU_ATTEN_6  As Byte
    Dim OLD_WPU_ATTEN_12  As Byte
    Dim Atten_Prev As Byte

    Dim Flg_PTT As Byte
    Dim Flg_QS As Byte

    Dim IO_State As Byte
    Dim Old_IO_State As Byte

    Dim Old_Aux1_In As Byte
    Dim Old_Aux2_In As Byte

    Dim Send_Byte As Byte

    Dim ADC_Lower As Byte
    Dim ADC_Upper As Byte
    Dim Quiet_Step As Byte
    Dim Under_Volt As Byte
    Dim Over_Volt As Byte
    Dim Current_Trip As Byte

    AUX1_OUT = 0
    AUX2_OUT = 0
    MOD = 0
    ONOFF = 0
    WPU_ATTEN_INF = 0
    WPU_ATTEN_12 = 0
    WPU_ATTEN_6  = 0
    LED = 0
    Serno = "12345678"
    Loop_Count = 100

CLC:

    CLC1CON = %00000010
    CLC2CON = %00000000
    CLC3CON = %00000000
    CLC4CON = %00000000

    CLCIN0PPS = 0x10

    CLCIN1PPS = 0x07

    CLCIN2PPS = 0x0B


    RC6PPS = 0x01

    RA6PPS = 0x02

    RB5PPS = 0x03

    CLC1POL = %00000000

    CLC1SEL0 = 0x00
    CLC1SEL1 = 0x02

    CLC1GLS0 = 0x02
    CLC1GLS1 = 0x02
    CLC1GLS2 = 0x08
    CLC1GLS3 = 0x08

    CLC2POL = %00000000

    CLC2SEL0 = 0x02
    CLC2SEL1 = 0x01
    CLC2SEL2 = 0x1F

    CLC2GLS0 = 0x02
    CLC2GLS1 = 0x08
    CLC2GLS2 = 0x04
    CLC2GLS3 = 0x20

    CLC3POL = %00000000

    CLC3SEL0 = 0x00
    CLC3SEL1 = 0x01
    CLC3SEL2 = 0x1F

    CLC3GLS0 = 0x20
    CLC3GLS1 = 0x04
    CLC3GLS2 = 0x08
    CLC3GLS3 = 0x02


    CLC1CON = %10000010

    CLC2CON = %10000000

    CLC3CON = %10000000

    LED = 0 : DelayMS 1500 : LED = 1 : DelayMS 200 : LED = 0
    DelayMS 200 : LED = 1 : DelayMS 500 : LED = 0: DelayMS 200 : LED = 1 :DelayMS 200 : LED = 0 : DelayMS 600

    If CRead HEF_Address = $3FFF And CRead HEF_Address + 1 = $3FFF Then

        GoSub Make_HEF_Array

        HEF_Array[0] = 0
        HEF_Array[1] = 2
        HEF_Array[2] = 0
        HEF_Array[3] = 1
        HEF_Array[4] = 255
        HEF_Array[5] = 0
        HEF_Array[6] = 0
        HEF_Array[7] = 0
        HEF_Array[8] = 0

        GoSub Write_HEF

    End If

    IO_config_byte = CRead HEF_Address
    Delay_Index = CRead HEF_Address + 1
    PHY_Power =  CRead HEF_Address + 2
    ADC_Lower =  CRead HEF_Address + 3
    ADC_Upper =  CRead HEF_Address + 4
    Quiet_Step = CRead HEF_Address + 5

    If PHY_Power = 1 Then PHY_Enable = 1: Else: PHY_Enable = 0

    Declare Hserial_Baud = 9600
    Declare Hserial_Clear = On

     Declare HSERIN_PIN PORTC.5
     RC1STA.7 = 1
     RC1STA.4 = 1
     TX1STA.4 = 0

    CH9121_CFG = 0
    Flg_QS = 0

Main:
    HSerIn 5,Loop_Checks,[CONTROL_byte, DATA_byte]

    GoSub Data_Process

Loop_Checks:

    IO_State = 0
    If AUX1_IN = 1 Then IO_State = 1
    If AUX2_IN = 1 Then IO_State = IO_State + 2

    If Old_IO_State <> IO_State  Then
            LED = 0
            IO_config_byte = CRead HEF_Address
            Delay_Index = CRead HEF_Address + 1

            CH1_IO_Cfg = (IO_config_byte & %00001111)
            CH2_IO_Cfg = (IO_config_byte & %11110000)

            If CH1_IO_Cfg = 4 Then

                    If  Old_Aux1_In <>  AUX1_IN Then

                            If AUX1_IN = 0 Then

                                    OLD_WPU_ATTEN_INF = WPU_ATTEN_INF
                                    OLD_WPU_ATTEN_12 = WPU_ATTEN_12

                                    WPU_ATTEN_INF = 0
                                    WPU_ATTEN_12 = 0

                                    If CH2_IO_Cfg = 128 And Delay_Index = 0 Then
                                        AUX2_OUT = 1
                                        SerOut MOD,4980,[122]
                                    ElseIf CH2_IO_Cfg = 128 Then
                                        SerOut MOD,4980,[122]
                                        GoSub Get_Delay_Actual
                                        DelayMS  Delay_actual
                                        AUX2_OUT = 1
                                    Else
                                        SerOut MOD,4980,[122]
                                    End If

                            ElseIf AUX1_IN = 1 Then

                                        If CH2_IO_Cfg = 128  And Delay_Index = 0 Then
                                                AUX2_OUT = 0
                                        ElseIf  CH2_IO_Cfg = 128 Then
                                                AUX2_OUT = 0
                                                GoSub Get_Delay_Actual
                                                DelayMS  Delay_actual
                                        End If
                                    SerOut MOD,4980,[123]

                                    WPU_ATTEN_INF = OLD_WPU_ATTEN_INF
                                    WPU_ATTEN_12 = OLD_WPU_ATTEN_12
                            End If
                    Old_Aux1_In = AUX1_IN
                    End If
             End If

             If CH2_IO_Cfg = 64 Then

                    If  Old_Aux2_In <> AUX2_IN Then

                            If AUX2_IN = 0 Then

                                    OLD_WPU_ATTEN_INF = WPU_ATTEN_INF
                                    OLD_WPU_ATTEN_12 = WPU_ATTEN_12

                                    WPU_ATTEN_INF = 0
                                    WPU_ATTEN_12 = 0

                                    If CH1_IO_Cfg = 8 And Delay_Index = 0 Then
                                        AUX1_OUT = 1
                                        SerOut MOD,4980,[122]
                                    ElseIf CH1_IO_Cfg = 8 Then
                                        SerOut MOD,4980,[122]
                                        GoSub Get_Delay_Actual
                                        DelayMS  Delay_actual
                                        AUX1_OUT = 1
                                    Else
                                        SerOut MOD,4980,[122]
                                    End If

                            ElseIf AUX2_IN = 1 Then
                                        If CH2_IO_Cfg = 8  And Delay_Index = 0 Then
                                                AUX2_OUT = 0
                                        ElseIf  CH2_IO_Cfg = 8 Then
                                                AUX2_OUT = 0
                                                GoSub Get_Delay_Actual
                                                DelayMS  Delay_actual
                                        End If
                                    SerOut MOD,4980,[123]

                                    WPU_ATTEN_INF = OLD_WPU_ATTEN_INF
                                    WPU_ATTEN_12 = OLD_WPU_ATTEN_12
                            End If
                    Old_Aux2_In = AUX2_IN
                    End If
             End If

            Send_Byte = 0
            If AUX1_IN = 0 Then Send_Byte = 1
            If AUX2_IN = 0 Then Send_Byte = Send_Byte + 2
            CONTROL_byte = 3
            HSerOut [CONTROL_byte, Send_Byte]

            Old_IO_State = 0
            If AUX1_IN = 1 Then Old_IO_State = 1
            If AUX2_IN = 1 Then Old_IO_State = Old_IO_State + 2
    End If

    GoSub Read_ADC

    If ONOFF = 1 Then LED = 1

    GoTo Main



Data_Process:

    If CH9121_CFG = 1 Then
         If CONTROL_byte <> 19 And DATA_byte <> 0 Then GoTo Main
    End If

    If ONOFF = 1 Then LED = 0

    Select Case CONTROL_byte

        Case 1
            GoSub Handle_Type_1

        Case 2
            GoSub Send_PC_Reply

        Case 4
           GoSub CHANGE_IO

        Case 5
            IO_config_byte = DATA_byte

            GoSub Make_HEF_Array
            HEF_Array[0] = IO_config_byte
            GoSub Write_HEF

            DelayMS 50

            DATA_byte = CRead HEF_Address
            CONTROL_byte = 6
            HSerOut [CONTROL_byte, DATA_byte]

        Case 7
            DATA_byte = CRead HEF_Address
            CONTROL_byte = 6
            HSerOut [CONTROL_byte, DATA_byte]

        Case 8
            If DATA_byte = 1 Then
                   ONOFF = 1
                   LED = 1
            Else
                   ONOFF = 0
                   LED = 0
            End If

            CONTROL_byte = 40
             HSerOut [CONTROL_byte, DATA_byte]
            INTCONbits_GIE = 1

        Case 9
             CONTROL_byte = 10
             HSerOut [CONTROL_byte, DATA_byte]

        Case 11
              If DATA_byte = 1 Then
                PHY_Enable = 1
                PHY_Power = 1
              Else If DATA_byte = 0 Then
                PHY_Enable = 0
                PHY_Power = 0
              End If

              GoSub Make_HEF_Array
              HEF_Array[2] = PHY_Power
              GoSub Write_HEF

        Case 12
             DATA_byte = 101
             HSerOut [13, DATA_byte]

        Case 14

             WPU_ATTEN_INF = 0
             WPU_ATTEN_6 = 0
             WPU_ATTEN_12 = 0

            ONOFF = 0
            LED = 0

       Case 15

            Asm
            Clrf INTCON
            Movlp 0x1e
            GoTo 0x600
            EndAsm

       Case 16
            Delay_Index = DATA_byte

            GoSub Make_HEF_Array
            HEF_Array[1] = Delay_Index
            GoSub Write_HEF

            GoSub Get_Delay_Actual

            DATA_byte = CRead (HEF_Address  + 1)
            HSerOut [17, DATA_byte]
CFG:
        Case 18

            DATA_byte = CRead (HEF_Address  + 1)
            HSerOut [17, DATA_byte]

        Case 19
                If DATA_byte = 1   Then
                    CH9121_CFG = 1
                     RC1STA.4 = 0
                     DelayMS 1000
                     CH9121_CFG = 0
                     RC1STA.4 = 1
                Else
                    CH9121_CFG = 0
                End If

       Case 20
             DATA_byte = 0
             HSerOut [21, DATA_byte]

       Case 24
             If DATA_byte = 1 Then
                DATA_byte = CRead (HEF_Address  + 2)
                HSerOut [25, DATA_byte]
             End If
       Case 28
            GoSub Read_ADC
            HSerOut [29, ADC_Byte]

      Case 37
        If DATA_byte = 255 Then
            DATA_byte = CRead  (HEF_Address  + 5)
            Quiet_Step = DATA_byte
            HSerOut [38, DATA_byte]
        Else
            GoSub Make_HEF_Array
            HEF_Array[5] = DATA_byte
            Quiet_Step = DATA_byte
            GoSub Write_HEF
            HSerOut [38, DATA_byte]
        End If
     End Select

    If ONOFF = 1 Then LED = 1

Return


Read_ADC:
        ADCON0.1 = 1
        DelayMS 1
        Repeat : Until ADCON0.1 = 0
        ADC_Byte = ADRESH
Return

Return

Make_HEF_Array:
        For i = 0 UpTo 63
            HEF_Array[i] = CRead (i + $1F80)
        Next
Return

Write_HEF:

    CErase $1F80
    DelayMS 20

    For i = 0 UpTo 63
        CWrite (HEF_Address + i), [HEF_Array[i]]
    Next
    DelayMS 20
Return

Send_PC_Reply:

    CONTROL_byte = 3
    DATA_byte = %00000000
    If AUX2_IN = 0 Then DATA_byte = (DATA_byte + %00000010)
    If AUX1_IN = 0 Then DATA_byte = (DATA_byte + %00000001)

     HSerOut [CONTROL_byte, DATA_byte]
Return


CHANGE_IO:

    IO_config_byte = CRead HEF_Address

    If IO_config_byte.1 = 1 Then
            AUX1_OUT = DATA_byte.0
    End If

    If IO_config_byte.5 = 1 Then
            AUX2_OUT  = DATA_byte.1
    End If

    Return

GET_IO:
    DATA_byte = 0
    If AUX1_IN = 0 Then DATA_byte = DATA_byte | %00000001
    If AUX2_IN = 0 Then DATA_byte = DATA_byte | %00000010
    CONTROL_byte = %10000000
     HSerOut [CONTROL_byte, DATA_byte]
Return

Handle_Type_1:
    If DATA_byte = 90 Or DATA_byte = 91 Then
       Flg_QS = 1
    ElseIf DATA_byte > 87 And DATA_byte < 102 Then
       Flg_QS = 0
    End If

    If DATA_byte = 122 Then
        OLD_WPU_ATTEN_INF  = WPU_ATTEN_INF
        OLD_WPU_ATTEN_12 = WPU_ATTEN_12

        WPU_ATTEN_INF = 0
        WPU_ATTEN_12 = 0
        SerOut MOD,4980,[122]
        Return
     Else If  DATA_byte = 123 Then
        WPU_ATTEN_INF = OLD_WPU_ATTEN_INF
        WPU_ATTEN_12 = OLD_WPU_ATTEN_12
        SerOut MOD,4980,[123]
        Return
    End If

    If DATA_byte < 104 Or DATA_byte > 121 Then
        SerOut MOD,4980,[DATA_byte]

        If Quiet_Step = 1 Then
            LATA.0 = 1
            DelayMS 8
            LATA.0 = 0
        ElseIf  Quiet_Step = 2 And Flg_QS = 1 Then
            LATA.0 = 1
            DelayMS 8
            LATA.0 = 0
        End If

    ElseIf DATA_byte > 103 Then
        GoSub Handle_Atten
    End If

    HSerOut [33, 1]
Return

Handle_Atten:

    If DATA_byte = 104 Then

         WPU_ATTEN_INF = 1
         WPU_ATTEN_6 = 1
         WPU_ATTEN_12 = 1

    Else If DATA_byte = 106 Then

         WPU_ATTEN_INF = 1
         WPU_ATTEN_6 = 0
         DelayMS 5
         WPU_ATTEN_12 = 1

    Else If DATA_byte = 108 Then

         WPU_ATTEN_INF = 1
         WPU_ATTEN_12 = 0
         DelayMS 5
         WPU_ATTEN_6 = 1

    Else If DATA_byte = 110 Then

         WPU_ATTEN_INF = 1
         WPU_ATTEN_6 = 0
         WPU_ATTEN_12 = 0

    Else If DATA_byte = 118 Then

         WPU_ATTEN_INF = 0
         WPU_ATTEN_6 = 0
         WPU_ATTEN_12 = 0

    End If
Return

Get_Delay_Actual:
    Select Case Delay_Index
        Case 0
            Delay_actual = 0
        Case 1
            Delay_actual = 0
        Case 2
            Delay_actual = 50
        Case 3
            Delay_actual = 100
        Case 4
            Delay_actual = 145
        Case 5
            Delay_actual = 150
        Case 6
            Delay_actual = 250
       Case Else
            Delay_actual = 0
    End Select
Return


TIMEOUT1:

   GoTo Main

  GoTo Main
